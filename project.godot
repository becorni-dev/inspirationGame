; Fichier de configuration du projet Godot.
; Ouvrir ce dossier avec Godot 4.7 (version standard, pas .NET).

config_version=5

[application]

config/name="Nouvelle Rive"
config/description="Prototype de jeu de gestion et de construction en 3D."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.05, 1)
textures/default_filters/anisotropic_filtering_level=4

[shader_globals]

night={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 1.0
}
